{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["jest", "node", "@testing-library/jest-dom"],
  },
  "include": [
    "src/**/*",
    "client/components/**/*.tsx",
    "client/app/**/*.{ts,tsx}",
    "__tests__/**/*",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
