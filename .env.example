# Unified Next.js app (UI + API on one port)
PORT=3000
NODE_ENV=development
HOSTNAME=localhost

# MongoDB
# Local Mongo without auth:
# MONGO_URI=mongodb://localhost:27017/projects
#
# Docker Compose Mongo (default host port 27178) — include credentials:
MONGO_URI=mongodb://root:rootpassword@localhost:27178/projects?authSource=admin

# Auth (Node >=20.19.0 required)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=1h
# COOKIE_SECURE=true   # force Secure on rbac_session cookie (auto in production)

# API edge security (optional overrides)
# JSON_BODY_LIMIT=100kb
# API_RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20
# Set TRUST_PROXY=1 when behind a reverse proxy (Docker Compose nginx sets this on app).
# TRUST_PROXY=1

# Admin seed (required for database-init / Docker). Sign in with ADMIN_EMAIL (not username).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Same-origin API (default). Absolute URL only if API is hosted separately.
NEXT_PUBLIC_API_BASE_URL=/api
# Local `npm run dev`: http://localhost:3000 — Docker Compose (nginx): http://localhost
CLIENT_URL=http://localhost:3000

# Email (password reset + account verification). Default in development/test: console logger.
# Production requires EMAIL_PROVIDER=smtp or module (console is refused).
EMAIL_PROVIDER=console
# EMAIL_FROM=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Custom sender module exporting send(message) or { send }:
# EMAIL_PROVIDER=module
# EMAIL_SENDER_MODULE=./path/to/myMailer.js

# Google OAuth (optional). When set, Sign in / Register show "Continue with Google".
# Create an OAuth 2.0 Web client in Google Cloud Console and add the redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: API-only mode (`npm run api:only`)
# API_PORT=5000

# Docker Compose credentials (also used to auto-fill MONGO_URI auth when missing)
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=rootpassword
MONGO_HOST_PORT=27178
NGINX_HOST_PORT=80
DB_NAME=projects

# Reports GraphQL service (UI uses same-origin /api/reports).
# Local (npm run dev + reports on host): http://localhost:8000
# Docker Compose overrides REPORTS_URL to http://reports:8000 inside the app container.
REPORTS_URL=http://localhost:8000
NEXT_PUBLIC_REPORTS_URL=http://localhost
CORS_ORIGINS=http://localhost,http://127.0.0.1
REPORTS_REQUIRE_AUTH=true
