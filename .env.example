# Server
PORT=5000
NODE_ENV=development

# MongoDB (local default)
MONGO_URI=mongodb://localhost:27017/projects
# MONGODB_URI is also accepted by database-init / Docker
# MONGODB_URI=mongodb://localhost:27017/projects

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Admin seed (required for database-init / Docker)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Frontend
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Docker Compose overrides (optional)
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=rootpassword
MONGO_HOST_PORT=27178
APP_HOST_PORT=9980
DB_NAME=projects
