# Unified Next.js app (UI + API on one port)
PORT=3000
NODE_ENV=development
HOSTNAME=localhost

# MongoDB
# Local Mongo without auth:
# MONGO_URI=mongodb://localhost:27017/projects
#
# Docker Compose Mongo (default host port 27178) — include credentials:
MONGO_URI=mongodb://root:rootpassword@localhost:27178/projects?authSource=admin

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Admin seed (required for database-init / Docker)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Same-origin API (default). Absolute URL only if API is hosted separately.
NEXT_PUBLIC_API_BASE_URL=/api
CLIENT_URL=http://localhost:3000

# Optional: API-only mode (`npm run api:only`)
# API_PORT=5000

# Docker Compose credentials (also used to auto-fill MONGO_URI auth when missing)
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=rootpassword
MONGO_HOST_PORT=27178
APP_HOST_PORT=3000
DB_NAME=projects
